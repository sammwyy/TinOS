# Editor/LSP configuration matching the freestanding kernel build.
CompileFlags:
  Add:
    - -Ikernel/include
    - -Idesktop/include
    - -Ilibraries/image/include
    - -Ilibraries/audio/include
    - -ffreestanding
    - -nostdinc
    - -std=gnu11
    - -m32
    - -Wno-unused-parameter
  Compiler: gcc
